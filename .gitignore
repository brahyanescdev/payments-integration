# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# test & coverage
coverage/
playwright-report/
test-results/
.playwright/

# environment — real values never get committed
.env
.env.local
.env.*.local

# infrastructure — state.json holds the RDS password, *.pem the SSH key
infra/.venv/
infra/state.json
infra/*.pem

# editors & OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# generated PR body (regenerated by `pnpm evidence` on every run)
.github/pr-body.md
