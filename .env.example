# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Every variable here is validated at boot by the
# typed config module; a missing or malformed value fails fast with its name.
# Real secrets live in AWS Secrets Manager, never in this file.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://payments:payments@localhost:5432/payments

# --- Payment service provider (PSP) ------------------------------------------
# `http` talks to the real sandbox; `fake` uses the in-memory adapter used by CI.
PAYMENT_GATEWAY_DRIVER=fake
PSP_BASE_URL=https://api-sandbox.co.uat.wompi.dev/v1
PSP_PUBLIC_KEY=replace-me
PSP_PRIVATE_KEY=replace-me
PSP_INTEGRITY_SECRET=replace-me
PSP_EVENTS_SECRET=replace-me
PSP_TIMEOUT_MS=10000

# --- Checkout pricing rules --------------------------------------------------
CHECKOUT_CURRENCY=COP
CHECKOUT_BASE_FEE_IN_CENTS=300000
CHECKOUT_DELIVERY_FEE_IN_CENTS=800000
CHECKOUT_FREE_DELIVERY_THRESHOLD_IN_CENTS=20000000
CHECKOUT_MAX_INSTALLMENTS=36

# --- Reliability -------------------------------------------------------------
IDEMPOTENCY_TTL_HOURS=24
CATALOG_PAGE_SIZE=20
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=30

# --- Frontend (apps/web) -----------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_TRANSACTION_POLL_INTERVAL_MS=2000
VITE_TRANSACTION_POLL_TIMEOUT_MS=180000
